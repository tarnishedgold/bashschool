POSTGRES_DB=bashkir
POSTGRES_USER=bashkir
POSTGRES_PASSWORD=change_this_password
JWT_SECRET=replace_this_with_a_unique_random_secret_at_least_32_characters
# Optional: bot works after adding token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: create the initial administrator on startup (set both)
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change_me_to_a_long_admin_password

# Optional; server-side only. Without a key literature import & manual moderation still work.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4.1-mini

# Optional for a separate frontend origin; comma-separated allowlist.
# The default Docker frontend uses same-origin /api/v1 via nginx.
WEB_ORIGIN=http://localhost:5173
